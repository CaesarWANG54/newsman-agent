# Local Docker Compose deployment. No credentials are required for excerpt mode.
NEWSMAN_APP_NAME=NewsMan Agent
NEWSMAN_ENV=local
NEWSMAN_WEB_PORT=3300
NEWSMAN_API_PORT=8300
NEWSMAN_LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NEWSMAN_DAILY_TIMEZONE=Asia/Shanghai
NEWSMAN_DAILY_UPDATE_ENABLED=false
NEWSMAN_DAILY_UPDATE_HOUR=8
NEWSMAN_DAILY_UPDATE_MINUTE=0
NEWSMAN_MAX_ARTICLES_PER_RUN=80
NEWSMAN_DIGEST_ARTICLE_LIMIT=15
